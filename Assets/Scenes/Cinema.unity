    - target: {fileID: 8670411874848046228, guid: 74cc959faae61bb489748f6723f6da18, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Hedefin izleyece\u011Fi film belirli hedefi salonda bulabilirsin."
      objectReference: {fileID: 0}
    - target: {fileID: 8670411874848046228, guid: 74cc959faae61bb489748f6723f6da18, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "Senin  i\xE7in sinemada bir i\u015F g\xF6r\xFC\u015Fmesi ayarlad\u0131k
