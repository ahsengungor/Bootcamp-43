      objectReference: {fileID: 0}
    - target: {fileID: 8670411874848046228, guid: 74cc959faae61bb489748f6723f6da18, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Unutma, i\u015F g\xF6r\xFC\u015Fmesi  yapaca\u011F\u0131n ki\u015Fi
